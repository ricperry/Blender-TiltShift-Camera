+/* M2 deliberately rejects projection-dependent modes which have not yet been
+ * validated, rather than silently rendering an ordinary or center-time camera. */
+string Camera::tilt_shift_error(Scene *scene, Device *device)
+{
+  if (!tilt_shift_enabled) {
+    return "";
+  }
+  const string prefix = "Physical Tilt-Shift: ";
+  if (device->info.type != DEVICE_CPU) {
+    return prefix + "only CPU rendering is validated; GPU support requires M4";
+  }
+  if (camera_type != CAMERA_PERSPECTIVE) {
+    return prefix + "requires a perspective camera";
+  }
+  if (scene->need_motion() != Scene::MOTION_NONE) {
+    return prefix + "motion blur and motion-vector passes are not supported in M2";
+  }
+  if (tilt_shift_multiview || use_spherical_stereo || stereo_eye != STEREO_NONE) {
+    return prefix + "stereo rendering is not supported in M2";
+  }
+  const float f = tilt_shift_focal_length;
+  if (!std::isfinite(f) || f <= 0.0f ||
+      (!tilt_shift_use_focus_point && (!std::isfinite(focaldistance) || focaldistance <= 0.0f)) ||
+      !std::isfinite(tilt_shift_tilt) || !std::isfinite(tilt_shift_swing) ||
+      !std::isfinite(tilt_shift_axis_rotation) || !std::isfinite(tilt_shift_circle_radius) ||
+      tilt_shift_circle_radius < 0.0f || !std::isfinite(aperturesize) || aperturesize < 0.0f ||
+      !std::isfinite(aperture_ratio) || aperture_ratio <= 0.0f)
+  {
+    return prefix + "nonfinite or invalid optical parameters";
+  }
+  const auto optics = camera_tilt_shift_optics(this);
+  const float3 target = tilt_shift_focus_point - tilt_shift_lens_center;
+  if (!isfinite_safe(tilt_shift_lens_center) ||
+      (tilt_shift_use_focus_point &&
+       (!isfinite_safe(target) || target.z <= 0.0f ||
+        tilt_shift_native::dot(optics.normal, {target.x, target.y, target.z}) <=
+            f * (1.0f + 1e-5f))))
+  {
+    return prefix + "focus target must lie in front of the lens beyond its focal plane";
+  }
+  /* Dimensionless float domain margin, independently measured against M1.
+   * This is rejection, never a silent angle/focus clamp. */
+  constexpr float epsilon = 1e-5f;
+  const float denominator = f / optics.sensor_distance;
+  if (optics.normal.z <= epsilon || denominator <= epsilon ||
+      !std::isfinite(optics.sensor_distance))
+  {
+    return prefix + "focus/tilt requires a nonpositive or singular sensor distance";
+  }
+  const float az = aperturesize * sqrtf((optics.aperture_x.z / aperture_ratio) *
+                                            (optics.aperture_x.z / aperture_ratio) +
+                                        optics.aperture_y.z * optics.aperture_y.z);
+  const float scale = max(
+      f, max(optics.sensor_distance, max(aperturesize / aperture_ratio, aperturesize)));
+  if (!std::isfinite(az) || !std::isfinite(nearclip) || nearclip <= az + epsilon * scale ||
+      !std::isfinite(farclip) || farclip <= nearclip)
+  {
+    return prefix + "clip planes must lie in front of the entire tilted aperture";
+  }
+  update(scene);
+  /* All supported filters fit 1.5*width; include one neighboring pixel for
+   * derivatives and numerical guard at the actual raster-domain corners. */
+  const float padding = 1.5f * scene->film->get_filter_width() + 1.0f;
+  for (const float x : {-padding, width + padding}) {
+    for (const float y : {-padding, height + padding}) {
+      const float3 q = transform_perspective(&rastertocamera, make_float3(x, y, 0.0f));
+      const auto p = tilt_shift_native::sensor(optics, q.x / q.z, q.y / q.z);
+      const float np = tilt_shift_native::dot(optics.normal, p);
+      const float h = 1.0f + np / f;
+      const float local_scale = max(scale, max(fabsf(p.x), fabsf(p.y)));
+      if (!std::isfinite(np) || np >= -epsilon * local_scale ||
+          optics.sensor_distance - fabsf(h) * az <= epsilon * local_scale ||
+          optics.sensor_distance - az <= epsilon * local_scale)
+      {
+        return prefix + "sensor/aperture crosses a singular or backward-ray domain";
+      }
+    }
+  }
+  return "";
+}
