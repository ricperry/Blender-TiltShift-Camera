+/* Original physical-guide implementation: GPL-3.0-or-later.
+ * Same Rz Ry Rx + Y reflection as the Cycles native camera. No kernel dependency:
+ * the RNA geometry API tests these independently against sampled physical rays. */
+CameraTiltShiftGuides BKE_camera_tilt_shift_guides(const Object *ob,
+                                                   const float view_roll,
+                                                   const bool view_flip_x)
+{
+  CameraTiltShiftGuides g;
+  if (!ob || ob->type != OB_CAMERA) {
+    return g;
+  }
+  const Camera *cam = id_cast<const Camera *>(ob->data);
+  if (!cam->tilt_shift_enabled || cam->type != CAM_PERSP) {
+    return g;
+  }
+  constexpr float margin = 1e-5f;
+  const float f = cam->lens * 1e-3f;
+  const float ct = cosf(cam->tilt_shift_tilt), st = sinf(cam->tilt_shift_tilt);
+  const float cs = cosf(cam->tilt_shift_swing), ss = sinf(cam->tilt_shift_swing);
+  const float ca = cosf(cam->tilt_shift_axis_rotation), sa = sinf(cam->tilt_shift_axis_rotation);
+  const float3 n(ca * ss * ct + sa * st, -sa * ss * ct + ca * st, cs * ct);
+  const float3 ex(ca * cs, -sa * cs, -ss);
+  const float3 ey(ca * ss * st - sa * ct, -sa * ss * st - ca * ct, cs * st);
+  const float sensor = BKE_camera_sensor_size(cam->sensor_fit, cam->sensor_x, cam->sensor_y) *
+                       1e-3f;
+  const float2 shift = BKE_camera_viewplane_offset_transform(
+      view_roll, view_flip_x, sensor * float2(cam->shiftx, cam->shifty));
+  const float3 center(shift.x, shift.y, 0.0f);
+  auto finite = [](const float3 &v) {
+    return std::isfinite(v.x) && std::isfinite(v.y) && std::isfinite(v.z);
+  };
+  auto local = [](const float3 &v) { return float3(v.x, v.y, -v.z); };
+  if (!(f > 0.0f && sensor > 0.0f && n.z > margin) || !finite(n) || !finite(center)) {
+    return g;
+  }
+  float3 anchor = center + float3(0.0f, 0.0f, cam->dof.focus_distance);
+  float b = f / (n.z - f / cam->dof.focus_distance);
+  if (cam->dof.focus_object) {
+    const Object *target = cam->dof.focus_object;
+    float4x4 target_mat = target->object_to_world();
+    if (bPoseChannel *pchan = BKE_pose_channel_find_name(target->pose, cam->dof.focus_subtarget)) {
+      target_mat = target_mat * float4x4(pchan->pose_mat);
+    }
+    float4x4 camera_mat = ob->object_to_world();
+    camera_mat.view<3, 3>() = math::normalize(camera_mat.view<3, 3>());
+    anchor = local(math::transform_point(math::invert(camera_mat), target_mat.location()));
+    const float3 q = anchor - center;
+    if (!(q.z > 0.0f && math::dot(n, q) > f * (1.0f + margin))) {
+      return g;
+    }
+    b = f * q.z / (math::dot(n, q) - f);
+  }
+  else if (!(cam->dof.focus_distance > 0.0f)) {
+    return g;
+  }
+  if (!std::isfinite(b) || !(b > 0.0f && f / b > margin) || !finite(anchor)) {
+    return g;
+  }
+  g.valid = true;
+  g.sensor_distance = b;
+  g.lens_center = local(center);
+  g.lens_normal = local(n);
+  const float extent = cam->drawsize * 0.5f;
+  if (!(extent > 0.0f) || !std::isfinite(extent)) {
+    return CameraTiltShiftGuides{};
+  }
+  const int signs[4][2] = {{-1, -1}, {1, -1}, {1, 1}, {-1, 1}};
+  for (int i = 0; i < 4; i++) {
+    g.lens[i] = local(center + extent * (signs[i][0] * ex + signs[i][1] * ey));
+  }
+  const float3 m = n - float3(0.0f, 0.0f, f / b);
+  const float m_length = math::length(m);
+  g.focus_plane = float4(local(m), f + math::dot(m, center));
+  /* Avoid constructing geometry at infinity or from a numerically singular normal. */
+  if (std::isfinite(m_length) && m_length > margin) {
+    const float3 unit = m / m_length;
+    const float3 seed = fabsf(unit.x) < 0.9f ? float3(1, 0, 0) : float3(0, 1, 0);
+    const float3 u = math::normalize(math::cross(unit, seed));
+    const float3 v = math::cross(unit, u);
+    g.focus_valid = true;
+    for (int i = 0; i < 4; i++) {
+      g.focus[i] = local(anchor + extent * (signs[i][0] * u + signs[i][1] * v));
+      g.focus_valid &= finite(g.focus[i]);
+    }
+  }
+  /* Project the actual angular boundary onto z=drawsize, not the tilted sensor.
+   * A closed curve is omitted entirely when it crosses an asymptote/back hemisphere. */
+  const float radius = cam->tilt_shift_image_circle_diameter * 0.0005f;
+  if (std::isfinite(radius) && radius > 0.0f &&
+      -f * n.z + radius * sqrtf(ex.z * ex.z + ey.z * ey.z) < -margin * math::max(f, radius))
+  {
+    g.circle_valid = true;
+    for (int i = 0; i < CameraTiltShiftGuides::circle_segments; i++) {
+      const float angle = 2.0f * float(M_PI) * i / CameraTiltShiftGuides::circle_segments;
+      const float3 rear = -f * n + radius * (cosf(angle) * ex + sinf(angle) * ey);
+      if (!(rear.z < -margin * math::max(f, radius))) {
+        g.circle_valid = false;
+        break;
+      }
+      g.circle[i] = local(center + (cam->drawsize / rear.z) * rear);
+      if (!finite(g.circle[i]) ||
+          math::length(g.circle[i] - g.lens_center) > cam->drawsize / margin)
+      {
+        g.circle_valid = false;
+        break;
+      }
+    }
+  }
+  return g;
+}
